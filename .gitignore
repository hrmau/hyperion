*.swo

# Archives
*.zip

# Regenerable curation worklist (see scripts/generate-questions.js)
scripts/question-candidates.json

# OWID source data — fetched by `npm run fetch-data`, never committed.
# It is ~16MB and fully regenerable; everything the site serves is derived from
# it into public/data. Committing it would add 16MB of churn per refresh.
data/owid-energy-data.csv

# Upstream vintage sidecar, written by fetch-owid.js alongside the CSV.
data/owid-source.json

# Python bytecode from running the pipeline scripts
__pycache__/
*.pyc

# Planning, specs, backlog and status notes live in docs/ and stay local: they
# are never pushed. Only the design system, which the code points at as its
# source of truth, is published. A new file dropped in docs/ is private by
# default; publishing one means adding a `!` line here on purpose.
/docs/*
!/docs/design-system/
